rules_version = '2';

// BSC KU Firestore Security Rules
// Paste into Firebase Console, Firestore Database, Rules, Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email allowlist (same list used in admin.html)
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'ahmed921x@gmail.com',
          'abdullaalshewaya66@gmail.com',
          'kmaldebs@gmail.com',
          'biosciclub@gmail.com'
        ];
    }

    // Public content: readable by everyone, writable by admins only.
    // events, notes, advisors, announcements, news, studentGuide,
    // majorSheets, supportSheets, gradCourses, teamMembers, majorResources,
    // aiKnowledge, schedules
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /advisors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /scheduleCommittee/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // الهيئة الأكاديمية للقسم — تُعرض في صفحة المرشدون.
    match /faculty/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /studentGuide/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /majorSheets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /supportSheets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gradCourses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teamMembers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /majorResources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /aiKnowledge/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schedules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User-generated content (no login required to create).

    // AI chat log: anyone can add, admin reads/deletes.
    match /aiChats/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Course suggestions: create for everyone, admin reviews.
    match /suggestions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Visitor note uploads, pending admin review.
    match /noteSubmissions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Student course explainers (YouTube links), pending admin review.
    // Anyone may bump `helpful` by exactly 1, but nothing else.
    match /courseVideos/{id} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpful']) &&
        request.resource.data.helpful == resource.data.helpful + 1
      );
      allow delete: if isAdmin();
    }

    // Comments under a course explainer. Published immediately (post-moderated),
    // so anyone may create and read, but only admins can edit or remove.
    match /videoComments/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Course ratings: create + read for everyone.
    // Site only shows approved ones. Status change/delete is admin-only.
    match /courseRatings/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Club membership applications. These carry real personal data — student
    // id, phone, GPA, a photo of the schedule — so unlike the other public
    // submissions they are never world-readable. The applicant reaches their
    // own application (to see whether it was accepted) through the anonymous
    // uid they already carry; nobody else reaches it but an admin.
    //
    // `list` is deliberately admin-only: a query without a uid filter would
    // otherwise dump every applicant's phone number in one request. That is
    // also why the document id IS the uid — the applicant can `get` their own
    // application by id without ever needing to run a query, and the id itself
    // enforces one application per student.
    match /memberships/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending';
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      // Applications are final once sent; an admin deletes to let a student
      // re-apply.
      allow update, delete: if isAdmin();
    }

    // The schedule photo, base64 in its own document so the admin list can load
    // a hundred applications without dragging a hundred images along with them —
    // the panel fetches one of these only when an admin opens it.
    //
    // Writable by the applicant only until their application exists, which both
    // allows a retry after a half-failed submit and freezes the photo the moment
    // the application is in.
    match /membershipPhotos/{uid} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && !exists(/databases/$(database)/documents/memberships/$(uid));
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Second confirmation photo (GPA + major GPA screenshot). Same shape and
    // same reasoning as membershipPhotos above — kept as its own collection
    // rather than a second field on the same document so each photo gets its
    // own ~1MiB budget instead of splitting one budget two ways.
    match /membershipGpaProof/{uid} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && !exists(/databases/$(database)/documents/memberships/$(uid));
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Registration window + committee list, edited from the admin panel.
    // Read is open because join.html has to know whether to show the form.
    match /membershipConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student accounts. Every visitor gets an anonymous uid, so this rule
    // covers everyone, signed in with Google or not: you reach your own
    // document and nothing else. Admins can read for the admin panel.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // GPA calculator save data, keyed by a random device id kept in the
    // student's own localStorage. Superseded by /students above — kept so
    // data saved before accounts existed can still be migrated in.
    //
    // `get` is open because the student's browser has to read back its own
    // document and there is no login on the calculator — but the id is random
    // and unguessable, so this only reaches the one who already has it.
    // `list` is the dangerous half: it would let anyone dump every student's
    // grades in one request. That is admin-only.
    match /gpaData/{deviceId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Visit counters, bumped by exactly +1 per visit.
    match /siteStats/{id} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1;
    }
    match /dailyVisits/{date} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1;
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
